#!/usr/bin/env node
import { accessSync, constants, readFileSync } from "node:fs";
import { join } from "node:path";
import { spawnSync } from "node:child_process";

const lintStaged = join(process.cwd(), "node_modules", "lint-staged", "bin", "lint-staged.js");

try {
  accessSync(lintStaged, constants.R_OK);
} catch {
  console.warn("[inseme] lint-staged is not installed at repository root. Run pnpm install to enable pre-commit checks.");
  process.exit(0);
}

try {
  readFileSync(lintStaged, "utf8");
} catch (error) {
  const code = error && typeof error === "object" ? error.code : undefined;
  if (code === "EPERM" || code === "EACCES") {
    console.warn("[inseme] lint-staged is present but unreadable in this shell. Skipping pre-commit checks.");
    process.exit(0);
  }

  throw error;
}

const result = spawnSync(process.execPath, [lintStaged], {
  cwd: process.cwd(),
  stdio: "inherit",
  env: process.env,
  shell: false,
});

if (result.error) {
  if (result.error.code === "EPERM" || result.error.code === "EACCES") {
    console.warn("[inseme] lint-staged could not be executed in this shell. Skipping pre-commit checks.");
    process.exit(0);
  }

  console.error(`[inseme] Failed to run lint-staged: ${result.error.message}`);
  process.exit(1);
}

process.exit(result.status ?? 1);
